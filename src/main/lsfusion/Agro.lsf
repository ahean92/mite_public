        FOR euName(EquipmentUnit u) = 'Поле кукурузы' DO { soilN(u) <- 34.0; soilP(u) <- 30.0; soilK(u) <- 155.0; }           // низкий K → Сульфат калия
        FOR euName(EquipmentUnit u) = 'Поле подсолнечника' DO { soilN(u) <- 33.0; soilP(u) <- 20.0; soilK(u) <- 210.0; }      // низкий P → Суперфосфат
        FOR euName(EquipmentUnit u) = 'Поле сои' DO { soilN(u) <- 35.0; soilP(u) <- 21.0; soilK(u) <- 205.0; }                // низкий P → Суперфосфат
        FOR euName(EquipmentUnit u) = 'Поле рапса' DO { soilN(u) <- 32.0; soilP(u) <- 31.0; soilK(u) <- 150.0; }              // низкий K → Сульфат калия
        FOR euName(EquipmentUnit u) = 'Грядки овощные' DO { soilN(u) <- 26.0; soilP(u) <- 22.0; soilK(u) <- 215.0; }          // N+P → NPK
        FOR euName(EquipmentUnit u) = 'Грядки клубники' DO { soilN(u) <- 24.0; soilP(u) <- 31.0; soilK(u) <- 165.0; }         // N+K → NPK
        FOR euName(EquipmentUnit u) = 'Теплица томаты' DO { soilN(u) <- 25.0; soilP(u) <- 36.0; soilK(u) <- 235.0; }          // низкий N → Карбамид
        FOR euName(EquipmentUnit u) = 'Теплица огурцы' DO { soilN(u) <- 35.0; soilP(u) <- 41.0; soilK(u) <- 245.0; }          // норма → поддержка NPK
        FOR euName(EquipmentUnit u) = 'Сад яблоневый' DO { soilN(u) <- 27.0; soilP(u) <- 30.0; soilK(u) <- 168.0; }           // N+K → NPK
        FOR euName(EquipmentUnit u) = 'Виноградник' DO { soilN(u) <- 26.0; soilP(u) <- 33.0; soilK(u) <- 215.0; }             // низкий N → Карбамид
        seedVer() <- 2;
        APPLY;
    }
}

onStarted() + {
    // ДЕМО-ДАННЫЕ (делянки, склад удобрений, партии, заявки) — ТОЛЬКО на стенде.
    // На боевой базе агро-объекты заводит заказчик, пересевать их нельзя.
    IF Mite.standMode() THEN agroSeed();
    // пересборка сцены нужна всегда: считает тип/позицию/фазу/покров по РЕАЛЬНЫМ данным.
    refreshAgroScene();
}
